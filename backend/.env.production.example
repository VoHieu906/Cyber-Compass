# Production settings for the api, worker and scheduler containers (ECS, ARCHITECTURE §8).
# A reference, never a file to deploy: on AWS these values are set in the task definitions
# (infrastructure/aws/), and every one marked SECRET comes from AWS Secrets Manager, never from
# git or the image. `php artisan cybercompass:preflight` checks them before each release.
# <domain> is the project's domain (D41).

APP_NAME=CyberCompass
APP_ENV=production
APP_DEBUG=false
# SECRET: php artisan key:generate --show (once; changing it signs everyone out)
APP_KEY=
APP_URL=https://api.<domain>
FRONTEND_URL=https://app.<domain>
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logs go to stdout/stderr, which ECS ships to CloudWatch Logs.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# RDS MySQL 8.4 (D43)
DB_CONNECTION=mysql
DB_HOST=<rds-endpoint>
DB_PORT=3306
DB_DATABASE=cybercompass
DB_USERNAME=cybercompass
# SECRET
DB_PASSWORD=

# Sessions, cache and queue in the database (D6)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.<domain>
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.<domain>
CORS_ALLOWED_ORIGINS=https://app.<domain>
CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail through SES's API with the task role's permission (D39): no keys.
MAIL_MAILER=ses
MAIL_FROM_ADDRESS=no-reply@<domain>
MAIL_FROM_NAME=CyberCompass

# Uploads in the private S3 bucket, served by CloudFront at media.<domain> (D41).
# No AWS keys: the task role grants access, and the SDK finds its credentials itself.
UPLOADS_DISK=s3
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=<uploads-bucket>
AWS_URL=https://media.<domain>
AWS_USE_PATH_STYLE_ENDPOINT=false

# SECRET: the same value as the web service's INTERNAL_API_TOKEN (32+ random characters)
INTERNAL_API_TOKEN=

CONTENT_SCRIPTED_3D=true

# Demo accounts are never created in production; leave both unset.
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=
