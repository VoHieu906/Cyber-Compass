{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence-review",
  "type": "object",
  "required": ["artifacts", "indicators", "checkpoints"],
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "title", "views"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "max_extra": { "type": "integer", "minimum": 0, "maximum": 10 },
          "views": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "label", "lines"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "label": { "type": "string", "minLength": 1, "maxLength": 60 },
                "mono": { "type": "boolean" },
                "lines": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "string", "maxLength": 300 } }
              }
            }
          }
        }
      }
    },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "title", "explanation", "lines"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 600 },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": ["artifact", "view", "line"],
              "additionalProperties": false,
              "properties": {
                "artifact": { "$ref": "#/$defs/id" },
                "view": { "$ref": "#/$defs/id" },
                "line": { "type": "integer", "minimum": 1, "maximum": 200 }
              }
            }
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/answer" },
          {
            "type": "object",
            "required": ["id", "title", "kind", "indicators"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "$ref": "#/$defs/title" },
              "hint": { "$ref": "#/$defs/hint" },
              "kind": { "const": "findings" },
              "indicators": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/id" } }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "hint": { "type": "string", "maxLength": 500 },
    "answer": {
      "type": "object",
      "required": ["id", "title", "kind", "answers"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/title" },
        "hint": { "$ref": "#/$defs/hint" },
        "kind": { "const": "answer" },
        "answers": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    }
  }
}
