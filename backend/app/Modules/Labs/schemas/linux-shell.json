{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "linux-shell",
  "type": "object",
  "required": ["hostname", "user", "home", "cwd", "files", "checkpoints"],
  "additionalProperties": false,
  "properties": {
    "hostname": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "user": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "home": { "type": "string", "pattern": "^/" },
    "cwd": { "type": "string", "pattern": "^/" },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 200,
      "propertyNames": { "pattern": "^/" },
      "additionalProperties": { "type": "string" }
    },
    "dirs": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^/" } },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/answer" },
          {
            "type": "object",
            "required": ["id", "title", "kind", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "$ref": "#/$defs/title" },
              "hint": { "$ref": "#/$defs/hint" },
              "kind": { "const": "read" },
              "path": { "type": "string", "pattern": "^/" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "hint": { "type": "string", "maxLength": 500 },
    "answer": {
      "type": "object",
      "required": ["id", "title", "kind", "answers"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/title" },
        "hint": { "$ref": "#/$defs/hint" },
        "kind": { "const": "answer" },
        "answers": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    }
  }
}
