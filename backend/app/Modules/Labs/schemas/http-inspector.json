{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "http-inspector",
  "type": "object",
  "required": ["app", "session", "routes", "checkpoints"],
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "object",
      "required": ["name", "origin"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 60 }, "origin": { "type": "string", "maxLength": 200 } }
    },
    "session": {
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 64 }, "value": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "captured": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["request", "response"],
        "additionalProperties": false,
        "properties": {
          "request": {
            "type": "object",
            "required": ["method", "path"],
            "additionalProperties": false,
            "properties": {
              "method": { "$ref": "#/$defs/method" },
              "path": { "type": "string", "pattern": "^/", "maxLength": 200 },
              "headers": { "$ref": "#/$defs/strings" },
              "body": { "type": "string", "maxLength": 2000 }
            }
          },
          "response": { "$ref": "#/$defs/response" }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "method", "path", "response"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "method": { "$ref": "#/$defs/method" },
          "path": { "type": "string", "pattern": "^/", "maxLength": 200 },
          "cookie": {
            "type": "object",
            "required": ["name", "value"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
          },
          "response": { "$ref": "#/$defs/response" },
          "unauthorized": { "$ref": "#/$defs/response" }
        }
      }
    },
    "not_found": { "$ref": "#/$defs/response" },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/answer" },
          {
            "type": "object",
            "required": ["id", "title", "kind", "route"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "$ref": "#/$defs/title" },
              "hint": { "$ref": "#/$defs/hint" },
              "kind": { "const": "request" },
              "route": { "$ref": "#/$defs/id" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "hint": { "type": "string", "maxLength": 500 },
    "method": { "enum": ["GET", "POST", "PUT", "DELETE"] },
    "strings": { "anyOf": [{ "type": "object", "maxProperties": 20, "additionalProperties": { "type": "string", "maxLength": 1000 } }, { "type": "array", "maxItems": 0 }] },
    "response": {
      "type": "object",
      "required": ["status", "headers", "body"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "headers": { "$ref": "#/$defs/strings" },
        "body": { "type": "string", "maxLength": 20000 }
      }
    },
    "answer": {
      "type": "object",
      "required": ["id", "title", "kind", "answers"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/title" },
        "hint": { "$ref": "#/$defs/hint" },
        "kind": { "const": "answer" },
        "answers": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    }
  }
}
