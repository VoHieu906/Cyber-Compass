{
  "type": "object",
  "required": ["id", "title", "kind", "question", "options", "answer", "evidence"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "hint": { "type": "string", "maxLength": 500 },
    "kind": { "const": "conclusion" },
    "question": { "type": "string", "minLength": 1, "maxLength": 500 },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
          "text": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "answer": { "type": "string", "maxLength": 60 },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "min_cited": { "type": "integer", "minimum": 1, "maximum": 30 },
    "max_cited": { "type": "integer", "minimum": 1, "maximum": 30 },
    "explanation": { "type": "string", "maxLength": 600 }
  }
}
