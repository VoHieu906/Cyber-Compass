{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flow",
  "description": "A process or decision flow, laid out automatically. Node and edge references are checked in FlowBlock.",
  "type": "object",
  "required": ["nodes", "edges"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" }
  },
  "properties": {
    "direction": { "enum": ["down", "right"] },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 60 },
          "kind": { "enum": ["start", "step", "decision", "end"] },
          "detail": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 30 }
        }
      }
    }
  },
  "examples": [
    {
      "direction": "down",
      "nodes": [
        { "id": "alert", "label": "Suspicious login alert", "kind": "start" },
        { "id": "known", "label": "Known device and place?", "kind": "decision" },
        { "id": "close", "label": "Close as benign", "kind": "end" },
        { "id": "reset", "label": "Reset password and revoke sessions", "kind": "end", "detail": "Then ask the user how the password could have leaked." }
      ],
      "edges": [
        { "from": "alert", "to": "known" },
        { "from": "known", "to": "close", "label": "Yes" },
        { "from": "known", "to": "reset", "label": "No" }
      ]
    }
  ]
}
