{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "step-through",
  "x-factual": true,
  "description": "An annotated walkthrough. Each step can show a row of parts (headers wrapping data, say) and a list of values; values that changed since the previous step are highlighted.",
  "type": "object",
  "required": ["steps"],
  "additionalProperties": false,
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "text"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "text": { "type": "string", "minLength": 1, "maxLength": 800 },
          "parts": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["label"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                "tone": { "enum": ["accent", "attn", "muted", "plain"] }
              }
            }
          },
          "state": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                "value": { "type": "string", "minLength": 1, "maxLength": 80 }
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "steps": [
        { "title": "Application data", "text": "The browser has an HTTP request to send.", "parts": [{ "label": "HTTP GET", "tone": "accent" }] },
        { "title": "Transport adds a TCP header", "text": "Ports say which program should receive the data.", "parts": [{ "label": "TCP", "tone": "muted" }, { "label": "HTTP GET", "tone": "accent" }], "state": [{ "label": "Unit", "value": "Segment" }] },
        { "title": "Network adds an IP header", "text": "Addresses say which machine should receive it.", "parts": [{ "label": "IP", "tone": "muted" }, { "label": "TCP", "tone": "muted" }, { "label": "HTTP GET", "tone": "accent" }], "state": [{ "label": "Unit", "value": "Packet" }] }
      ]
    }
  ]
}
