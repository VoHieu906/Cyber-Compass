{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "comparison",
  "description": "Side-by-side attributes of 2 to 4 things. Every row has one value per column (checked in ComparisonBlock).",
  "type": "object",
  "required": ["columns", "rows"],
  "additionalProperties": false,
  "properties": {
    "columns": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["label", "values"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 60 },
          "values": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    }
  },
  "examples": [
    {
      "columns": ["TCP", "UDP"],
      "rows": [
        { "label": "Connection", "values": ["Set up with a handshake", "None"] },
        { "label": "Delivery", "values": ["Guaranteed and in order", "Best effort"] },
        { "label": "Typical use", "values": ["Web, email, SSH", "DNS, video calls, games"] }
      ]
    }
  ]
}
