{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "steps",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 600 }
    }
  },
  "examples": [{ "items": ["Keep your current SSH session open.", "Check the configuration with sudo sshd -t.", "Reload the service."] }]
}
