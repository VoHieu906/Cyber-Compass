{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-check",
  "x-factual": false,
  "description": "One to three ungraded questions. Answers ship with the lesson and never affect progress (PHASE_3_5 A4). Each question needs at least one correct option (checked in KnowledgeCheckBlock); several correct options make it a choose-all question.",
  "type": "object",
  "required": ["questions"],
  "additionalProperties": false,
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["prompt", "options", "explanation"],
        "additionalProperties": false,
        "properties": {
          "prompt": { "type": "string", "minLength": 1, "maxLength": 300 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["text", "correct"],
              "additionalProperties": false,
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 200 },
                "correct": { "type": "boolean" }
              }
            }
          },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    }
  },
  "examples": [
    {
      "questions": [
        {
          "prompt": "Which layer does a SYN flood target?",
          "options": [
            { "text": "Transport (layer 4)", "correct": true },
            { "text": "Data link (layer 2)", "correct": false },
            { "text": "Application (layer 7)", "correct": false }
          ],
          "explanation": "A SYN flood abuses the TCP handshake, which is part of the transport layer."
        }
      ]
    }
  ]
}
