{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "callout",
  "x-factual": {
    "property": "tone",
    "in": ["info", "warning", "fun-fact"],
    "notes": { "fun-fact": "An analogy needs no source, so you may ignore this; an anecdote (how something came about) needs one." }
  },
  "type": "object",
  "required": ["text", "tone"],
  "additionalProperties": false,
  "properties": {
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "tone": { "enum": ["info", "tip", "warning", "recap", "fun-fact"] }
  },
  "examples": [{ "text": "Never fix a permissions problem with chmod 777.", "tone": "warning" }]
}
