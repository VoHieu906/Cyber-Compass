{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "onion",
  "description": "Concentric rings, the first node is the core and the last the outermost ring. Checked after architecture.json; cross-references in MapSchemas.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "id": true,
          "label": true,
          "note": true,
          "section": true,
          "lesson": true
        }
      }
    }
  }
}
