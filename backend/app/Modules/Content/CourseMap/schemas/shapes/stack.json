{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stack",
  "description": "A LIFO stack, the first node at the bottom and the last on top (pushed last, popped first). Checked after architecture.json; cross-references in MapSchemas.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "id": true,
          "label": true,
          "note": true,
          "section": true,
          "lesson": true
        }
      }
    }
  }
}
