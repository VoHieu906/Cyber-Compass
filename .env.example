# docker-compose variables (copy to .env). Application settings live in backend/.env and frontend/.env.local.

# MySQL container credentials. Must match DB_* in backend/.env.
DB_DATABASE=cybercompass
DB_USERNAME=cybercompass
DB_PASSWORD=change-me-local-only
DB_ROOT_PASSWORD=change-me-root-local-only

# Host ports
FORWARD_API_PORT=8000
FORWARD_WEB_PORT=3000
FORWARD_DB_PORT=3307
FORWARD_MAILPIT_UI_PORT=8025

# The browser reaches the API on the host port.
NEXT_PUBLIC_API_URL=http://localhost:8000
