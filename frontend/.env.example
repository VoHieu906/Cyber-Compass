# Base URL of the Laravel API as the browser sees it (no trailing slash). Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: the API address used by Server Components when it differs from the browser's,
# e.g. http://api:8080 inside docker-compose or an internal load balancer on AWS. Runtime only.
# INTERNAL_API_URL=

# Optional, server-only: the shared secret the API expects in X-Internal-Token on server-side reads
# (the same value as INTERNAL_API_TOKEN in backend/.env). Required on AWS; leave unset locally.
# INTERNAL_API_TOKEN=

# Optional, server-only: origin that serves uploaded images when it differs from the API
# (CloudFront for the uploads bucket on AWS, D41). Added to the Content Security Policy.
# CSP_MEDIA_ORIGIN=

# Optional: true sends the Content Security Policy as report-only (a rollback switch, D42).
# CSP_REPORT_ONLY=
