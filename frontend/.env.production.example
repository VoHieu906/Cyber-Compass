# Production settings for the web container (ECS, ARCHITECTURE §8). A reference, never a file to
# deploy: on AWS these are set in the task definition (infrastructure/aws/); the one marked SECRET
# comes from AWS Secrets Manager. <domain> is the project's domain (D41).

# Build argument, not a runtime variable: it is compiled into the browser bundle.
#   docker build --target production --build-arg NEXT_PUBLIC_API_URL=https://api.<domain> frontend
NEXT_PUBLIC_API_URL=https://api.<domain>

# Runtime, server-side only.
INTERNAL_API_URL=https://api.<domain>
# SECRET: the same value as the API's INTERNAL_API_TOKEN (docs/SECURITY_REVIEW.md S8)
INTERNAL_API_TOKEN=
# Where uploaded images load from (CloudFront in front of the uploads bucket), for the CSP.
CSP_MEDIA_ORIGIN=https://media.<domain>
# true sends the Content Security Policy as report-only: the rollback switch (D42).
CSP_REPORT_ONLY=false
