{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Requests and 5xx (ALB)",
        "region": "${AWS_REGION}",
        "stat": "Sum",
        "period": 300,
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/ApplicationELB",
            "RequestCount",
            "LoadBalancer",
            "${ALB_DIMENSION}"
          ],
          [
            "AWS/ApplicationELB",
            "HTTPCode_Target_5XX_Count",
            "LoadBalancer",
            "${ALB_DIMENSION}"
          ],
          [
            "AWS/ApplicationELB",
            "HTTPCode_ELB_5XX_Count",
            "LoadBalancer",
            "${ALB_DIMENSION}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Response time p95 (ALB, seconds)",
        "region": "${AWS_REGION}",
        "stat": "p95",
        "period": 300,
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/ApplicationELB",
            "TargetResponseTime",
            "LoadBalancer",
            "${ALB_DIMENSION}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "CPU % by service (ECS)",
        "region": "${AWS_REGION}",
        "stat": "Average",
        "period": 300,
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/ECS",
            "CPUUtilization",
            "ClusterName",
            "${CLUSTER}",
            "ServiceName",
            "${APP}-api"
          ],
          [
            "AWS/ECS",
            "CPUUtilization",
            "ClusterName",
            "${CLUSTER}",
            "ServiceName",
            "${APP}-web"
          ],
          [
            "AWS/ECS",
            "CPUUtilization",
            "ClusterName",
            "${CLUSTER}",
            "ServiceName",
            "${APP}-worker"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Memory % by service (ECS)",
        "region": "${AWS_REGION}",
        "stat": "Average",
        "period": 300,
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/ECS",
            "MemoryUtilization",
            "ClusterName",
            "${CLUSTER}",
            "ServiceName",
            "${APP}-api"
          ],
          [
            "AWS/ECS",
            "MemoryUtilization",
            "ClusterName",
            "${CLUSTER}",
            "ServiceName",
            "${APP}-web"
          ],
          [
            "AWS/ECS",
            "MemoryUtilization",
            "ClusterName",
            "${CLUSTER}",
            "ServiceName",
            "${APP}-worker"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Database connections and CPU % (RDS)",
        "region": "${AWS_REGION}",
        "stat": "Average",
        "period": 300,
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/RDS",
            "DatabaseConnections",
            "DBInstanceIdentifier",
            "${APP}"
          ],
          [
            "AWS/RDS",
            "CPUUtilization",
            "DBInstanceIdentifier",
            "${APP}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Free storage (RDS, bytes)",
        "region": "${AWS_REGION}",
        "stat": "Minimum",
        "period": 300,
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/RDS",
            "FreeStorageSpace",
            "DBInstanceIdentifier",
            "${APP}"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 18,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "Queue: pending and failed jobs (from the scheduler's log line)",
        "region": "${AWS_REGION}",
        "stat": "Maximum",
        "period": 60,
        "view": "timeSeries",
        "metrics": [
          [
            "CyberCompass",
            "QueuePending"
          ],
          [
            "CyberCompass",
            "QueueFailed"
          ]
        ]
      }
    }
  ]
}
