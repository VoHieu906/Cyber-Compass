{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadsBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::${UPLOADS_BUCKET}/*"
    },
    {
      "Sid": "SendMailFromTheDomain",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "arn:aws:ses:${AWS_REGION}:${AWS_ACCOUNT_ID}:identity/${DOMAIN}"
    }
  ]
}
