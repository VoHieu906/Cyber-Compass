{
  "family": "${APP}-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${APP}-ecs-execution",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${APP}-api-task",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_API}:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "APP_NAME",
          "value": "CyberCompass"
        },
        {
          "name": "APP_ENV",
          "value": "production"
        },
        {
          "name": "APP_DEBUG",
          "value": "false"
        },
        {
          "name": "APP_URL",
          "value": "https://api.${DOMAIN}"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://app.${DOMAIN}"
        },
        {
          "name": "APP_LOCALE",
          "value": "en"
        },
        {
          "name": "APP_FALLBACK_LOCALE",
          "value": "en"
        },
        {
          "name": "LOG_CHANNEL",
          "value": "stderr"
        },
        {
          "name": "LOG_LEVEL",
          "value": "info"
        },
        {
          "name": "DB_CONNECTION",
          "value": "mysql"
        },
        {
          "name": "DB_HOST",
          "value": "${RDS_ENDPOINT}"
        },
        {
          "name": "DB_PORT",
          "value": "3306"
        },
        {
          "name": "DB_DATABASE",
          "value": "cybercompass"
        },
        {
          "name": "DB_USERNAME",
          "value": "cybercompass"
        },
        {
          "name": "SESSION_DRIVER",
          "value": "database"
        },
        {
          "name": "SESSION_LIFETIME",
          "value": "120"
        },
        {
          "name": "SESSION_DOMAIN",
          "value": ".${DOMAIN}"
        },
        {
          "name": "SESSION_SECURE_COOKIE",
          "value": "true"
        },
        {
          "name": "SESSION_SAME_SITE",
          "value": "lax"
        },
        {
          "name": "SANCTUM_STATEFUL_DOMAINS",
          "value": "app.${DOMAIN}"
        },
        {
          "name": "CORS_ALLOWED_ORIGINS",
          "value": "https://app.${DOMAIN}"
        },
        {
          "name": "CACHE_STORE",
          "value": "database"
        },
        {
          "name": "QUEUE_CONNECTION",
          "value": "database"
        },
        {
          "name": "MAIL_MAILER",
          "value": "ses"
        },
        {
          "name": "MAIL_FROM_ADDRESS",
          "value": "no-reply@${DOMAIN}"
        },
        {
          "name": "MAIL_FROM_NAME",
          "value": "CyberCompass"
        },
        {
          "name": "UPLOADS_DISK",
          "value": "s3"
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "${AWS_REGION}"
        },
        {
          "name": "AWS_BUCKET",
          "value": "${UPLOADS_BUCKET}"
        },
        {
          "name": "AWS_URL",
          "value": "https://media.${DOMAIN}"
        },
        {
          "name": "AWS_USE_PATH_STYLE_ENDPOINT",
          "value": "false"
        },
        {
          "name": "CONTENT_SCRIPTED_3D",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "APP_KEY",
          "valueFrom": "${SECRET_ARN}:APP_KEY::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "${SECRET_ARN}:DB_PASSWORD::"
        },
        {
          "name": "INTERNAL_API_TOKEN",
          "valueFrom": "${SECRET_ARN}:INTERNAL_API_TOKEN::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/${APP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
